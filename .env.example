# =============================================================================
# Aegys Bot Configuration (.env.example)
# Copy to .env and fill in only the channels and backend you want to enable.
# =============================================================================

# --- Core Server ---
AEGYS_PORT=8090
AEGYS_HOST=127.0.0.1
AEGYS_BOT_NAME=Aegys
AEGYS_COMMANDS_FILE=config/commands.example.json
# Shared Bearer token required for POST /api/v1/notify and authenticated webhooks
AEGYS_API_SECRET=change-me-to-a-strong-random-secret

# --- Developer Mock Mode (Zero Tokens Required) ---
# Enables /api/v1/dev/simulate and works with `aegys --dev-cli`
ENABLE_MOCK=false

# --- AI Backend (Choose: mock | agy-gateway | ollama | openai) ---
AI_BACKEND=mock
AI_SYSTEM_PROMPT=You are Aegys, a concise and reliable personal operations assistant.

# Option 1: AGY Mobile Gateway (https://github.com/AetherCore-Works/agy-mobile)
AGY_GATEWAY_URL=http://127.0.0.1:8088
AGY_GATEWAY_SECRET=

# Option 2: Direct Ollama (Local LLM)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Option 3: OpenAI-Compatible API (OpenAI, OpenRouter, Groq, vLLM, LM Studio)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- RBAC (Role-Based Access Control) ---
# Comma-separated platform-scoped IDs (or plain IDs matching any platform):
#   Format: "discord:111111111111111111,telegram:222222222,whatsapp:5500999990000"
# Admins have full access (system commands, /wol, /run, /tasks, AI).
ADMIN_USER_IDS=mock:admin
# Standard users can use safe Fast-Path commands (/ping, /help, /whoami) and /ask (AI).
ALLOWED_USER_IDS=mock:user
# Restrict bots to Direct Messages only (recommended for personal/admin setups)
DM_ONLY=true

# --- Channel: Discord (Gateway WebSocket + REST v10) ---
ENABLE_DISCORD=false
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# Optional: register slash commands in a single guild for instant propagation during dev
DISCORD_DEV_GUILD_ID=

# --- Channel: Telegram (Long-Polling or Webhook) ---
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
# Mode: polling | webhook
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# --- Channel: WhatsApp (Pluggable Provider) ---
ENABLE_WHATSAPP=false
# Driver: evolution | webhook
WHATSAPP_PROVIDER=evolution
WHATSAPP_WEBHOOK_SECRET=

# WhatsApp Driver: Evolution API v2
EVOLUTION_API_URL=http://127.0.0.1:8085
EVOLUTION_INSTANCE=aegys
EVOLUTION_API_KEY=

# WhatsApp Driver: Generic Webhook Proxy (when WHATSAPP_PROVIDER=webhook)
WHATSAPP_GENERIC_SEND_URL=
WHATSAPP_GENERIC_AUTH_TOKEN=
